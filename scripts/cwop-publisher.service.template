[Unit]
Description=CWOP (findU/APRS-IS) Weather Publisher
After=network-online.target docker.service

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
ExecStart=/usr/bin/python3 __REPO_DIR__/scripts/cwop_publisher.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target

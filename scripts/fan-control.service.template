[Unit]
Description=Staged Fan Speed Controller
After=network.target docker.service

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
ExecStart=__REPO_DIR__/.venv-fan-control/bin/python3 __REPO_DIR__/scripts/fan_control.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

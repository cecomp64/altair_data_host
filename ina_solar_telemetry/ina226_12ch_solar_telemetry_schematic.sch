(kicad_sch (version 20211123) (generator eeschema)

  (uuid "a12c226f-12ch-4000-8000-dc12v20asolar")

  (paper "A3")

  (title_block
    (title "12-Channel Solar DC Telemetry & Power Distribution Block (20A/Ch)")
    (date "2026-09-01")
    (rev "v1.0")
    (company "Custom Solar Telemetry Solution")
    (comment 1 "Uses 12x INA226 hardware addressable chips on a shared isolated I2C bus")
    (comment 2 "Heavy 2oz/3oz copper traces reinforced for 20A continuous load per channel")
  )

  (comment "This file serves as a readable ASCII hardware netlist descriptor blueprint for KiCad/EDA software imports.")

  ;; SYSTEM ISOLATOR
  (symbol (lib_id "Isolator:ISO1540") (at 50 50 0)
    (pin "1" (name "VCC1") (type power_in))
    (pin "2" (name "SDA1") (type bidirectional))
    (pin "3" (name "SCL1") (type input))
    (pin "4" (name "GND1") (type power_in))
    (pin "5" (name "GND2") (type power_in))
    (pin "6" (name "SCL2") (type output))
    (pin "7" (name "SDA2") (type bidirectional))
    (pin "8" (name "VCC2") (type power_in))
  )

  ;; CHANNEL MATRIX DEFINITION FOR MANUFACTURER ASSEMBLY (BOM & NETLIST)
  ;; Format: Channel [1-12] -> INA226 (Addr 0x40 - 0x4B) -> Shunt (0.002 Ohm, 5W)

  (channel_1
    (designator "U1")
    (component "TI_INA226_AIDGSR")
    (i2c_address "0x40")
    (pin_config (A0 "GND") (A1 "GND"))
    (shunt_resistor "R_SHUNT_1" (value "0.002 Ohm") (footprint "Shunt_2512_5W") (rating "20A Continuous"))
    (input_fuse "FUSE_1" (value "20A_Mini_Blade") (type "Automotive_PCB_Holder"))
    (connections
      (net "12V_BUS_BAR" -> "FUSE_1_IN")
      (net "FUSE_1_OUT" -> "U1_IN+" -> "R_SHUNT_1_1" -> "U1_VBUS")
      (net "LOAD_OUT_1" -> "U1_IN-" -> "R_SHUNT_1_2" -> "SCREW_TERMINAL_1_POS")
      (net "SHARED_SYSTEM_I2C_SDA" -> "U1_SDA")
      (net "SHARED_SYSTEM_I2C_SCL" -> "U1_SCL")
      (net "HIGH_SIDE_POWER_GND" -> "U1_GND")
    )
  )

# Copy to `.env` and fill in real values, or just run scripts/deploy.sh -
# it will generate a `.env` with random secrets automatically if one is missing.
# .env is gitignored - never commit real secrets.

INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=changeme
INFLUXDB_ORG=solar
INFLUXDB_ADMIN_TOKEN=changeme

# One bucket per data domain - see README "InfluxDB Architecture" section for
# why these are split (retention differs a lot by domain).
INFLUXDB_BUCKET_POWER=power
INFLUXDB_BUCKET_WEATHER=weather
INFLUXDB_BUCKET_OBSERVATORY=observatory
INFLUXDB_BUCKET_IMAGING=imaging
INFLUXDB_BUCKET_NETWORK=network
INFLUXDB_BUCKET_STARLINK=starlink

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- Weather: LAN weather station local API -------------------------------
# Full URL scripts/read_ecowitt.py will poll (GET, expects JSON). For an
# Ecowitt GW1000/GW2000-style gateway this is
# http://<station-ip-or-hostname>/get_livedata_info - verify with
# `curl --compressed <url>` and check the sensor ids in read_ecowitt.py's
# COMMON_LIST_IDS/PIEZO_RAIN_IDS against your own response if they differ.
# Use a DHCP reservation or static IP for the station - a bare mDNS/IP here
# will silently break ingestion again if the address changes.
WEATHER_API_URL=http://weather-station.local/get_livedata_info
WEATHER_STATION_NAME=primary

# --- Observatory: roll-off-roof via ASCOM Alpaca ---------------------------
# Base URL up to and including the device number, e.g.
# http://roof-controller.local:11111/api/v1/dome/0
ALPACA_BASE_URL=http://roof-controller.local:11111/api/v1/dome/0
ALPACA_DOME_DEVICE_NUMBER=0
# Vendor-native status endpoint (not part of the Alpaca spec). Used because
# ASCOM's ShutterStatus enum (Open/Closed/Opening/Closing/Error) has no way
# to represent "stopped partway open" - the Alpaca layer reports that as
# Error, so this gives Grafana the controller's own, more granular state.
# Same host as ALPACA_BASE_URL, but at the device root, e.g.
# http://roof-controller.local/status
DRAGONLAIR_STATUS_URL=http://roof-controller.local/status

# --- Network: periodic ping health check (scripts/read_ping.py) ----------
# Comma-separated hosts/IPs to ping every 60s (3 packets each - see
# telegraf.conf "NETWORK" section for why this goes through a script rather
# than inputs.ping directly). Either can be left empty/unset to skip that
# group entirely. "internet" and "tailscale" are separate groups (and get a
# separate `network` tag in InfluxDB) so a downed Tailscale peer doesn't read
# as "the internet is down" on the dashboard.
PING_TARGETS_INTERNET=1.1.1.1,8.8.8.8,google.com
# Tailscale MagicDNS names of other machines on your tailnet worth watching,
# e.g. an always-on Pi or NAS - `tailscale status` lists what's available.
PING_TARGETS_TAILSCALE=octopi

# --- Starlink: dish power/alerts via its local gRPC API (scripts/read_starlink.py)
# Optional - defaults shown. Only change STARLINK_DISH_ADDR if your setup
# doesn't put the dish at its usual LAN address. STARLINK_POLL_INTERVAL_S
# should match telegraf.conf's "STARLINK" [[inputs.exec]] interval (also 60s
# by default) - it's how many of the dish's internal 1-second samples get
# averaged into each power reading; mismatched values just mean the power
# sample windows gap or overlap slightly, not a hard failure.
#STARLINK_DISH_ADDR=192.168.100.1:9200
#STARLINK_POLL_INTERVAL_S=60

# --- Charge cutoff: solar charging relay (scripts/charge_cutoff.py) -------
# Unset by default - scripts/install-charge-cutoff-service.sh skips
# installing the systemd service until this is set, since it's specific to
# how you wired the contactor's coil driver. BCM GPIO numbering.
#CHARGE_CUTOFF_GPIO_PIN=27
# Optional - defaults shown. LOW must stay below HIGH (enforced at startup)
# so the contactor doesn't chatter open/closed right at one threshold.
#CHARGE_CUTOFF_SOC_HIGH=85.0
#CHARGE_CUTOFF_SOC_LOW=80.0
#CHARGE_CUTOFF_POLL_INTERVAL=60
#CHARGE_CUTOFF_MIN_DWELL=300

# --- E-paper display (scripts/epaper_dashboard.py) -------------------------
# Optional - defaults shown. A full refresh under init_Fast() takes ~12.6s -
# 60s comfortably fits that with room to spare. Full refresh is self-cleaning
# (see README), so EPAPER_DEEP_CLEAR_EVERY's extra Clear() is just a rare
# safety net, not routine de-ghosting - 1440 * 60s is roughly once a day. Set
# to 0 to disable it outright.
#EPAPER_REFRESH_SECONDS=60
#EPAPER_DEEP_CLEAR_EVERY=1440

# --- Imaging: N.I.N.A. "InfluxDB Exporter" plugin --------------------------
# Nothing to set here - the plugin runs on the imaging PC (not this host) and
# writes to InfluxDB directly. Configure it in N.I.N.A.'s plugin options with:
#   InfluxDB Url:    http://<this-docker-host's-LAN-IP-or-hostname>:8086
#   InfluxDB Bucket: the value of INFLUXDB_BUCKET_IMAGING above
#   InfluxDB Org:    the value of INFLUXDB_ORG above
#   InfluxDB Token:  the value of INFLUXDB_ADMIN_TOKEN above
# See README "Imaging" section for details.

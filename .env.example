# Copy to `.env` and fill in real values, or just run scripts/deploy.sh -
# it will generate a `.env` with random secrets automatically if one is missing.
# .env is gitignored - never commit real secrets.

INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=changeme
INFLUXDB_ORG=solar
INFLUXDB_ADMIN_TOKEN=changeme

# One bucket per data domain - see README "InfluxDB Architecture" section for
# why these are split (retention differs a lot by domain).
INFLUXDB_BUCKET_POWER=power
INFLUXDB_BUCKET_WEATHER=weather
INFLUXDB_BUCKET_OBSERVATORY=observatory
INFLUXDB_BUCKET_IMAGING=imaging
INFLUXDB_BUCKET_NETWORK=network
INFLUXDB_BUCKET_STARLINK=starlink
INFLUXDB_BUCKET_SYSTEM=system

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
# Without this, links Grafana generates (alert notification "Source"/
# "Silence" links, share links, etc.) default to "localhost" - fine from
# the Pi itself, useless from a phone reading a Discord notification. Set
# to whatever's actually reachable from where you'll be reading those -
# your Tailscale hostname (works from anywhere on your tailnet), a LAN IP,
# or a real domain if you have one.
GRAFANA_ROOT_URL=http://<your-host>:3000

# --- Weather: LAN weather station local API -------------------------------
# Full URL scripts/read_ecowitt.py will poll (GET, expects JSON). For an
# Ecowitt GW1000/GW2000-style gateway this is
# http://<station-ip-or-hostname>/get_livedata_info - verify with
# `curl --compressed <url>` and check the sensor ids in read_ecowitt.py's
# COMMON_LIST_IDS/PIEZO_RAIN_IDS against your own response if they differ.
# Use a DHCP reservation or static IP for the station - a bare mDNS/IP here
# will silently break ingestion again if the address changes.
WEATHER_API_URL=http://weather-station.local/get_livedata_info
WEATHER_STATION_NAME=primary

# --- Astro: sun/moon altitude, computed locally (scripts/read_astro.py) ---
# Your site's coordinates, decimal degrees. Required - the script exits
# without emitting anything if either is unset. ELEVATION_M (meters) is
# optional and defaults to 0 - it only nudges the horizon-dip correction by
# a fraction of a degree, not worth being precise about.
LATITUDE=38.0
LONGITUDE=-121.0
ELEVATION_M=0

# --- Observatory: roll-off-roof via ASCOM Alpaca ---------------------------
# Base URL up to and including the device number, e.g.
# http://roof-controller.local:11111/api/v1/dome/0
ALPACA_BASE_URL=http://roof-controller.local:11111/api/v1/dome/0
ALPACA_DOME_DEVICE_NUMBER=0
# Vendor-native status endpoints (not part of the Alpaca spec). Used because
# ASCOM's ShutterStatus enum (Open/Closed/Opening/Closing/Error) has no way
# to represent "stopped partway open" - the Alpaca layer reports that as
# Error, so this gives Grafana the controller's own, more granular state.
# Same host as ALPACA_BASE_URL. /indi/status is the superset of the plain
# /status Draco endpoint (adds lastStateChangeReason, secondsToOpen/Close,
# cpuTemperature, uptime); /indi/full_status adds a handful of fields (safety
# monitor/weather/sun-altitude reasons, isRoofMoving, isManuallyOpened) that
# only exist nested under its "data" object, not on /indi/status. Both
# discovered via the device's own /openapi.yaml, not in the published manual.
DRAGONLAIR_STATUS_URL=http://roof-controller.local/indi/status
DRAGONLAIR_FULL_STATUS_URL=http://roof-controller.local/indi/full_status

# --- Network: periodic ping health check (scripts/read_ping.py) ----------
# Comma-separated hosts/IPs to ping every 60s (3 packets each - see
# telegraf.conf "NETWORK" section for why this goes through a script rather
# than inputs.ping directly). Either can be left empty/unset to skip that
# group entirely. "internet" and "tailscale" are separate groups (and get a
# separate `network` tag in InfluxDB) so a downed Tailscale peer doesn't read
# as "the internet is down" on the dashboard.
PING_TARGETS_INTERNET=1.1.1.1,8.8.8.8,google.com
# Tailscale MagicDNS names of other machines on your tailnet worth watching,
# e.g. an always-on Pi or NAS - `tailscale status` lists what's available.
PING_TARGETS_TAILSCALE=octopi

# --- Starlink: dish power/alerts via its local gRPC API (scripts/read_starlink.py)
# Optional - defaults shown. Only change STARLINK_DISH_ADDR if your setup
# doesn't put the dish at its usual LAN address. STARLINK_POLL_INTERVAL_S
# should match telegraf.conf's "STARLINK" [[inputs.exec]] interval (also 60s
# by default) - it's how many of the dish's internal 1-second samples get
# averaged into each power reading; mismatched values just mean the power
# sample windows gap or overlap slightly, not a hard failure.
#STARLINK_DISH_ADDR=192.168.100.1:9200
#STARLINK_POLL_INTERVAL_S=60

# --- Discord alerting (scripts/init-grafana-alerting.sh) ------------------
# Unset by default - deploy.sh skips alerting setup until this is set.
# Create a webhook in Discord: Server Settings > Integrations > Webhooks >
# New Webhook, pick a channel, "Copy Webhook URL". Provisions a "discord"
# contact point, points the default notification policy at it, and creates
# 8 alert rules (battery SOC critical, Starlink alert active, internet
# fully down, disk usage critical, Pi under-voltage, CPU temp critical,
# camera offline) - see that script and init_grafana_alerting.py for the exact
# thresholds/queries, and README §13 for why this is a script rather than
# committed YAML like the rest of the
# Grafana config (a confirmed Grafana bug: env var expansion doesn't work
# in alerting provisioning files - it crash-loops Grafana instead).
# Re-run scripts/init-grafana-alerting.sh any time you change this or the
# rule thresholds.
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Charge cutoff: solar charging relay (scripts/charge_cutoff.py) -------
# Unset by default - scripts/install-charge-cutoff-service.sh skips
# installing the systemd service until this is set, since it's specific to
# how you wired the contactor's coil driver. BCM GPIO numbering.
#CHARGE_CUTOFF_GPIO_PIN=27
# Optional - defaults shown. LOW must stay below HIGH (enforced at startup)
# so the contactor doesn't chatter open/closed right at one threshold.
#CHARGE_CUTOFF_SOC_HIGH=85.0
#CHARGE_CUTOFF_SOC_LOW=80.0
#CHARGE_CUTOFF_POLL_INTERVAL=60
#CHARGE_CUTOFF_MIN_DWELL=300

# --- Fan control: staged PWM cooling fan (scripts/fan_control.py) --------
# Unset by default - scripts/install-fan-control-service.sh skips installing
# the systemd service until this is set, since it's specific to how you
# wired the fan's PWM/Trigger MOSFET. BCM GPIO numbering.
#FAN_CONTROL_GPIO_PIN=26
# Optional - defaults shown. Thresholds are indoor/enclosure ambient temp
# (deg F, weather station's own indoor sensor - weather_station.temp_in_f
# in the weather bucket, same reading the dashboard's indoor temp stat
# tile uses). HYSTERESIS_F is how far temp must drop below a stage's own
# turn-on threshold before stepping back down, so the fan doesn't chatter
# at a single threshold. DUTY_* are PWM duty cycle (0.0-1.0) per stage -
# raise DUTY_LOW if your fan doesn't spin at 40%. PWM_FREQUENCY_HZ is
# software PWM (GPIO26 has no hardware PWM channel) - 1kHz is a
# conservative, glitch-free default.
#FAN_CONTROL_TEMP_LOW=80.0
#FAN_CONTROL_TEMP_MEDIUM=90.0
#FAN_CONTROL_TEMP_HIGH=100.0
#FAN_CONTROL_HYSTERESIS_F=5.0
#FAN_CONTROL_DUTY_LOW=0.4
#FAN_CONTROL_DUTY_MEDIUM=0.7
#FAN_CONTROL_DUTY_HIGH=1.0
#FAN_CONTROL_PWM_FREQUENCY_HZ=1000
#FAN_CONTROL_POLL_INTERVAL=30
# SUPPLY_VOLTAGE_V/RATED_RPM/RATED_CURRENT_A are only used to compute
# *estimated* voltage_v/speed_rpm_est/power_w for the fan_control InfluxDB
# point (duty cycle * these values) - there's no voltage/current sensor or
# tachometer wire on this circuit. Defaults match this repo's own fan (12V,
# 3000 RPM, 1.2A rated) - change if yours differs.
#FAN_CONTROL_SUPPLY_VOLTAGE_V=12.0
#FAN_CONTROL_RATED_RPM=3000
#FAN_CONTROL_RATED_CURRENT_A=1.2

# --- CWOP: publish weather to findU/NOAA (scripts/cwop_publisher.py) ------
# Unset by default - scripts/install-cwop-service.sh skips installing the
# systemd service until CWOP_ID is set. Use the ID NOAA assigned you
# (CWxxxx, or a ham callsign). Uses LATITUDE/LONGITUDE/ELEVATION_M above -
# they must match what you registered with CWOP. Posts unverified (-1
# passcode), which CWOP allows for CW IDs.
#CWOP_ID=CW1234
# Seconds between reports (minimum 300 - CWOP asks for no more than one per
# 5 min; 600 is typical).
#CWOP_INTERVAL=600
# Set to 1 only if the station console's relative pressure is already
# calibrated to sea level. By default station pressure is reduced to sea
# level using ELEVATION_M and outdoor temp (CWOP requires sea-level).
#CWOP_PRESSURE_IS_SEA_LEVEL=0

# --- E-paper display (scripts/epaper_dashboard.py) -------------------------
# Optional - defaults shown. A full refresh under init_Fast() takes ~12.6s -
# 60s comfortably fits that with room to spare. Full refresh is self-cleaning
# (see README), so EPAPER_DEEP_CLEAR_EVERY's extra Clear() is just a rare
# safety net, not routine de-ghosting - 1440 * 60s is roughly once a day. Set
# to 0 to disable it outright.
#EPAPER_REFRESH_SECONDS=60
#EPAPER_DEEP_CLEAR_EVERY=1440

# --- Imaging: N.I.N.A. "InfluxDB Exporter" plugin --------------------------
# Nothing to set here - the plugin runs on the imaging PC (not this host) and
# writes to InfluxDB directly. Configure it in N.I.N.A.'s plugin options with:
#   InfluxDB Url:    http://<this-docker-host's-LAN-IP-or-hostname>:8086
#   InfluxDB Bucket: the value of INFLUXDB_BUCKET_IMAGING above
#   InfluxDB Org:    the value of INFLUXDB_ORG above
#   InfluxDB Token:  the value of INFLUXDB_ADMIN_TOKEN above
# See README "Imaging" section for details.

# --- Cameras: Reolink snapshot polling (scripts/read_cameras.py) -----------
# LAN IPs of the three Reolink cameras. CAMERA_POLE_SOUTH is a dual-lens
# camera (one IP, two channels: panoramic + PTZ).
CAMERA_POLE_SOUTH=192.168.1.xxx
CAMERA_OBS_WEST=192.168.1.xxx
CAMERA_OBS_EAST=192.168.1.xxx
# Same login used for each camera's local web UI/API (Reolink's own app
# config, not anything this repo sets up).
REOLINK_USERNAME=admin
REOLINK_PASSWORD=changeme
# Optional - defaults shown match this repo's own camera, confirmed by
# comparing the two saved frames (not a documented Reolink convention - a
# different dual-lens model may need these flipped, or if the two
# snapshots come out swapped on yours).
#CAMERA_POLE_SOUTH_PTZ_CHANNEL=1
#CAMERA_POLE_SOUTH_PANO_CHANNEL=0
# Optional - defaults shown. LAN port camera-web (docker-compose.yml) serves
# snapshots on, for Grafana's "Cameras" row to <img src> directly - reachable
# from wherever you open Grafana, same as GRAFANA_ROOT_URL above.
#CAMERA_WEB_PORT=8089
